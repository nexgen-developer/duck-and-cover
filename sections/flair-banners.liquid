{%- liquid
  if search.performed
    assign flair_collection = collection
    assign flair_layout = ''
    assign flair_page_type = ''
    assign flair_terms = search.terms | split: ' OR '
    if flair_terms contains 'id:0'
      capture flair_form
        form 'localization'
        endform
      endcapture
      assign flair_query = flair_form | split: 'name="return_to" value="' | last | split: '"' | first | split: '?' | last | replace: '&amp;', '&'
      assign flair_params = flair_query | split: '&'
      for p in flair_params
        assign kv = p | split: '='
        assign k = kv[0]
        assign v = kv[1] | url_decode
        if k == '_col'
          assign flair_collection = collections[v]
        elsif k == '_lay'
          assign flair_layout = v | escape
        elsif k == '_pag'
          assign flair_page_type = v
        endif
      endfor
    else
      for t in flair_terms
        assign kv = t | split: ':'
        assign k = kv[0] | url_decode
        assign v = kv[1] | url_decode
        if k == '_col'
          assign flair_collection = collections[v]
        elsif k == '_lay'
          assign flair_layout = v | remove: '&quot;'
        elsif k == '_pag'
          assign flair_page_type = v
        endif
      endfor
    endif

    if flair_page_type == "product"
      assign flair_product = search.results | first
    endif
    render 'flair-banners' collection: flair_collection, product: flair_product, flair_layout: flair_layout, flair_page_type: flair_page_type
  else
    render 'flair-banners'
  endif
-%}
{%- schema -%}
  {
    "name": "Flair banners",
    "settings": []
  }
{%- endschema -%}
