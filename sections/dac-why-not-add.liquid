{%- comment -%}
  Why not add: pinned products first (the Mystery products by default), then the store's best sellers.
  Best sellers load after the page from Shopify's Best selling order (see dac-best-sellers), without the
  product being viewed or the pinned ones. Swipe on mobile, arrows on desktop.
{%- endcomment -%}
{{ 'dac-pdp.css' | asset_url | stylesheet_tag }}
<script src="{{ 'dac-pdp.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign s = section.settings
  assign side_min = s.padding_side | at_most: 10
  assign exclude = product.handle
  for pinned in s.pinned_products
    assign exclude = exclude | append: ',' | append: pinned.handle
  endfor
-%}

<section
  class="dac-wna"
  data-dac-wna
  data-url="{{ routes.root_url }}collections/all?sort_by=best-selling&section_id=dac-best-sellers"
  data-exclude="{{ exclude | escape }}"
  data-count="{{ s.best_sellers_count }}"
  data-atc="{{ s.atc_label | escape }}"
  data-sold-out="{{ s.sold_out_label | escape }}"
  data-options="{{ s.options_label | escape }}"
  data-error="{{ s.error_text | escape }}"
  data-badge="{% if s.show_badge %}{{ s.badge_text | escape }}{% endif %}"
  style="
    --dac-sw-title: {{ s.title_size }}px;
    --dac-sw-title-m: {{ s.title_size_mobile }}px;
    --dac-sw-title-color: {{ s.title_color }};
    --dac-sw-badge-bg: {{ s.badge_bg }};
    --dac-sw-pt: {{ s.padding_top }}px;
    --dac-sw-pb: {{ s.padding_bottom }}px;
    --dac-sw-side: clamp({{ side_min }}px, calc({{ side_min }}px + (100vw - 1025px) * {{ s.padding_side | minus: side_min }} / 895), {{ s.padding_side }}px);
    --dac-sw-pt-m: {{ s.padding_top_mobile }}px;
    --dac-sw-pb-m: {{ s.padding_bottom_mobile }}px;
    --dac-sw-side-m: {{ s.side_padding_mobile }}px;
  "
>
  <div class="dac-wna__head">
    <h2 class="dac-wna__title">{{ s.heading | escape }}</h2>
    <div class="dac-wna__arrows">
      <button type="button" class="dac-wna__arrow dac-wna__arrow--prev" data-dac-wna-prev aria-label="{{ s.prev_label | escape }}" disabled>
        {%- render 'dac-icon', icon: 'arrow-circle' -%}
      </button>
      <button type="button" class="dac-wna__arrow" data-dac-wna-next aria-label="{{ s.next_label | escape }}">
        {%- render 'dac-icon', icon: 'arrow-circle' -%}
      </button>
    </div>
  </div>
  <div class="dac-wna__track" data-dac-wna-track>
    {%- for pinned in s.pinned_products -%}
      {%- if pinned.handle == product.handle -%}{%- continue -%}{%- endif -%}
      {%- if pinned.available or s.show_sold_out_pinned -%}
        {% render 'dac-style-card', product: pinned, s: s, section_id: section.id, badge: s.pinned_badge, subtitle: s.pinned_text %}
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Why not add",
  "tag": "div",
  "class": "dac-wna-section",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Pinned products show first, then the store's best sellers in Shopify's Best selling order. Default sizes, spacing and colours follow the PDP V1 design in Figma."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Why not add"
    },
    {
      "type": "product_list",
      "id": "pinned_products",
      "label": "Pinned products",
      "info": "Always first, in this order. Pinned products without stock are skipped.",
      "limit": 4
    },
    {
      "type": "text",
      "id": "pinned_badge",
      "label": "Badge on pinned products",
      "default": "Surprise item"
    },
    {
      "type": "text",
      "id": "pinned_text",
      "label": "Line under pinned product names",
      "default": "A surprise Duck and Cover piece"
    },
    {
      "type": "checkbox",
      "id": "show_sold_out_pinned",
      "label": "Show pinned products that are sold out",
      "default": false
    },
    {
      "type": "range",
      "id": "best_sellers_count",
      "label": "Best sellers to show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 8
    },
    {
      "type": "header",
      "content": "Cards"
    },
    {
      "type": "checkbox",
      "id": "show_badge",
      "label": "Show sale badge",
      "default": true
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Sale badge text",
      "info": "[percent] becomes the saving.",
      "default": "Save [percent]%"
    },
    {
      "type": "color",
      "id": "badge_bg",
      "label": "Badge background",
      "default": "#D12442"
    },
    {
      "type": "text",
      "id": "atc_label",
      "label": "Add to bag label",
      "default": "Add to bag"
    },
    {
      "type": "text",
      "id": "sold_out_label",
      "label": "Sold out label",
      "default": "Sold out"
    },
    {
      "type": "text",
      "id": "options_label",
      "label": "Label for products with two options",
      "default": "Choose options"
    },
    {
      "type": "text",
      "id": "error_text",
      "label": "Message when no size is picked",
      "default": "Please select a size"
    },
    {
      "type": "text",
      "id": "prev_label",
      "label": "Previous arrow, screen reader name",
      "default": "Previous products"
    },
    {
      "type": "text",
      "id": "next_label",
      "label": "Next arrow, screen reader name",
      "default": "Next products"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "range",
      "id": "title_size",
      "label": "Heading size, desktop",
      "min": 20,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "title_size_mobile",
      "label": "Heading size, mobile",
      "min": 14,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Heading colour",
      "default": "#0B0B0C"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding, desktop",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding, desktop",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_side",
      "label": "Side padding, desktop",
      "info": "On a 1920px screen. Shrinks to 10px at 1025px.",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Top padding, mobile",
      "min": 0,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Bottom padding, mobile",
      "min": 0,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "side_padding_mobile",
      "label": "Side padding, mobile",
      "min": 0,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 10
    }
  ],
  "presets": [{ "name": "Why not add" }]
}
{% endschema %}
