{%- comment -%}
  Style with: products picked for each product in Shopify's Search & Discovery app (Complementary products).
  The cards load after the page through the Product Recommendations API. A product with none picked
  keeps the section hidden on the store. The large look photo is one of the product's own images.
{%- endcomment -%}
{{ 'dac-pdp.css' | asset_url | stylesheet_tag }}
<script src="{{ 'dac-pdp.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign s = section.settings
  assign look = blank
  if product and s.look_image_position > 0
    assign look_index = s.look_image_position | minus: 1
    assign look_media = product.media[look_index]
    if look_media
      assign look = look_media.preview_image
    endif
  endif
  assign side_min = s.padding_side | at_most: 10
-%}

<section
  class="dac-style{% if look != blank %} dac-style--has-look{% endif %}"
  data-dac-style
  data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ s.products_count }}&intent=complementary"
  {% unless request.design_mode %}hidden{% endunless %}
  style="
    --dac-sw-count: {{ s.products_count }};
    --dac-sw-title: {{ s.title_size }}px;
    --dac-sw-title-m: {{ s.title_size_mobile }}px;
    --dac-sw-title-color: {{ s.title_color }};
    --dac-sw-badge-bg: {{ s.badge_bg }};
    --dac-sw-pt: {{ s.padding_top }}px;
    --dac-sw-pb: {{ s.padding_bottom }}px;
    --dac-sw-side: clamp({{ side_min }}px, calc({{ side_min }}px + (100vw - 1025px) * {{ s.padding_side | minus: side_min }} / 895), {{ s.padding_side }}px);
    --dac-sw-pt-m: {{ s.padding_top_mobile }}px;
    --dac-sw-pb-m: {{ s.padding_bottom_mobile }}px;
    --dac-sw-side-m: {{ s.side_padding_mobile }}px;
  "
>
  <h2 class="dac-style__title">{{ s.heading | escape }}</h2>
  <div class="dac-style__row">
    {%- comment -%} != blank, not a bare if: an empty value is truthy in Liquid. {%- endcomment -%}
    {%- if look != blank -%}
      <div class="dac-style__look">
        {{ look | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '300, 400, 600, 800, 1000', sizes: '(min-width: 1025px) 26vw, 196px', alt: product.title }}
      </div>
    {%- endif -%}
    <div class="dac-style__cards" data-dac-style-cards>
      {%- if recommendations.performed? and recommendations.products_count > 0 -%}
        {%- for recommended in recommendations.products -%}
          {% render 'dac-style-card', product: recommended, s: s, section_id: section.id %}
        {%- endfor -%}
      {%- elsif request.design_mode -%}
        <p class="dac-editor-note">{{ s.empty_note | escape }}</p>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Style with",
  "tag": "div",
  "class": "dac-style-section",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Products come from Complementary products in the Search & Discovery app, picked for each product. Default sizes, spacing and colours follow the PDP V1 design in Figma."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Style with"
    },
    {
      "type": "range",
      "id": "products_count",
      "label": "Products to show",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "look_image_position",
      "label": "Look photo, product image number",
      "info": "Uses this image of the product as the large photo. 0 hides it. Products with fewer images show no look photo.",
      "min": 0,
      "max": 10,
      "step": 1,
      "default": 3
    },
    {
      "type": "text",
      "id": "empty_note",
      "label": "Note shown in the editor when nothing is picked",
      "default": "No complementary products picked for this product yet, so this section is hidden on the store. Pick them in Search & Discovery."
    },
    {
      "type": "header",
      "content": "Cards"
    },
    {
      "type": "checkbox",
      "id": "show_badge",
      "label": "Show sale badge",
      "default": true
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Sale badge text",
      "info": "[percent] becomes the saving.",
      "default": "Save [percent]%"
    },
    {
      "type": "color",
      "id": "badge_bg",
      "label": "Sale badge background",
      "default": "#D12442"
    },
    {
      "type": "text",
      "id": "atc_label",
      "label": "Add to bag label",
      "default": "Add to bag"
    },
    {
      "type": "text",
      "id": "sold_out_label",
      "label": "Sold out label",
      "default": "Sold out"
    },
    {
      "type": "text",
      "id": "options_label",
      "label": "Label for products with two options",
      "info": "These link to the product page instead of adding straight to the bag.",
      "default": "Choose options"
    },
    {
      "type": "text",
      "id": "error_text",
      "label": "Message when no size is picked",
      "default": "Please select a size"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "range",
      "id": "title_size",
      "label": "Heading size, desktop",
      "min": 20,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "title_size_mobile",
      "label": "Heading size, mobile",
      "min": 14,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Heading colour",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding, desktop",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding, desktop",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 30
    },
    {
      "type": "range",
      "id": "padding_side",
      "label": "Side padding, desktop",
      "info": "On a 1920px screen. Shrinks to 10px at 1025px.",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Top padding, mobile",
      "min": 0,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Bottom padding, mobile",
      "min": 0,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "side_padding_mobile",
      "label": "Side padding, mobile",
      "min": 0,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 10
    }
  ],
  "presets": [{ "name": "Style with" }]
}
{% endschema %}
