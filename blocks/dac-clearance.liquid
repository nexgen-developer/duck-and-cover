{%- comment -%}
  Clearance notice. Takes the place of the sign up offer on clearance products, which are set by tag in
  Theme settings > Clearance and Save badges. A heading over one line of text, no button.
  Special Offer products get their own heading and text (Andrew, 15 Oct).
{%- endcomment -%}
{%- liquid
  assign p = closest.product | default: product
  assign bs = block.settings
  capture flags
    render 'dac-promo-flags', product: p
  endcapture

  assign heading = bs.heading
  assign text = bs.text
  assign special_tags = bs.special_tags | split: ','
  for special_tag in special_tags
    assign special_clean = special_tag | strip
    if special_clean != blank and p.tags contains special_clean
      assign heading = bs.special_heading
      assign text = bs.special_text
    endif
  endfor
-%}
{%- if flags contains 'clearance' -%}
  <div
    class="dac-block dac-signup dac-clearance"
    style="--dac-mt: {{ bs.spacing_top }}px; --dac-mt-m: {{ bs.spacing_top_mobile }}px; --dac-bg: {{ bs.background }}; --dac-color: {{ bs.text_color }}; --dac-title-color: {{ bs.heading_color }}; --dac-title-fs: {{ bs.heading_size }}px; --dac-title-fs-m: {{ bs.heading_size_mobile }}px; --dac-fs: {{ bs.text_size }}px; --dac-fs-m: {{ bs.text_size_mobile }}px;"
    {{ block.shopify_attributes }}
  >
    {%- if heading != blank -%}
      <p class="dac-clearance__title">{{ heading | escape }}</p>
    {%- endif -%}
    {%- if text != blank -%}
      <p class="dac-signup__text">{{ text | escape }}</p>
    {%- endif -%}
  </div>
{%- elsif request.design_mode -%}
  <div class="dac-block dac-editor-note" {{ block.shopify_attributes }}>{{ bs.hidden_note }}</div>
{%- endif -%}

{% schema %}
{
  "name": "Clearance notice",
  "settings": [
    {
      "type": "paragraph",
      "content": "Shows only on clearance products, in place of the sign up offer. Clearance tags are set in Theme settings > Clearance and Save badges."
    },
    {
      "type": "header",
      "content": "Clearance products"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Clearance"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "Add a short clearance message in the theme editor."
    },
    {
      "type": "header",
      "content": "Special Offer products"
    },
    {
      "type": "text",
      "id": "special_tags",
      "label": "Special Offer tags",
      "info": "Products with one of these tags show this heading and text instead. Separate tags with commas.",
      "default": "VendorSpecialOffer"
    },
    {
      "type": "text",
      "id": "special_heading",
      "label": "Heading",
      "default": "Special Offer"
    },
    {
      "type": "text",
      "id": "special_text",
      "label": "Text",
      "default": "Add a short Special Offer message in the theme editor."
    },
    {
      "type": "text",
      "id": "hidden_note",
      "label": "Note shown in the editor when the block is hidden",
      "default": "Hidden on this product because it isn't tagged as clearance."
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#F4F4F4"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading colour",
      "default": "#222222"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text colour",
      "default": "#222222"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size, desktop",
      "min": 14,
      "max": 36,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "Heading size, mobile",
      "min": 14,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "Text size, desktop",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "text_size_mobile",
      "label": "Text size, mobile",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 13
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "spacing_top",
      "label": "Space above, desktop",
      "min": -20,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": -12
    },
    {
      "type": "range",
      "id": "spacing_top_mobile",
      "label": "Space above, mobile",
      "min": -20,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": -10
    }
  ],
  "presets": [{ "name": "Clearance notice" }]
}
{% endschema %}
